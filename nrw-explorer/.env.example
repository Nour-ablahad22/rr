# ---------------------------------------------------------------
# NRW Explorer – Frontend-Konfiguration (Vite, öffentlich im Bundle!)
# ---------------------------------------------------------------
# Browser-Schlüssel für die Google Maps JavaScript API.
# In der Google Cloud Console unbedingt einschränken:
#   - Anwendungsbeschränkung: HTTP-Referrer (z. B. https://<ihre-domain>/*, http://localhost:5173/*)
#   - API-Beschränkung: Maps JavaScript API, Places API (New), Geocoding API, Routes API
# Ohne Schlüssel nutzt die App im Entwicklungsmodus eine OpenStreetMap-Karte (Leaflet)
# und weist sichtbar darauf hin.
VITE_GOOGLE_MAPS_API_KEY=
# Map-ID für Advanced Markers (Cloud-basiertes Kartenstyling). DEMO_MAP_ID funktioniert für Tests.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Datenquelle: "local" (eingebauter Datensatz, keine API nötig) oder "api" (Azure Functions unter /api)
VITE_DATA_SOURCE=local
# Optional: abweichende API-Basis-URL (Standard: /api – bei Azure Static Web Apps automatisch verknüpft)
VITE_API_BASE_URL=/api

# Öffentliche Basis-URL für kanonische Links, Open Graph und Sitemap
VITE_SITE_URL=https://www.nrw-explorer.example
